# Copy to .env for local runs. In GitHub Actions these live in repo Secrets.
#
# Gmail rejects your normal account password over SMTP. You need an App
# Password, which requires 2-Step Verification to be on:
#   1. Enable 2FA:      https://myaccount.google.com/security
#   2. Create password: https://myaccount.google.com/apppasswords
#   3. Paste the 16 characters WITHOUT the spaces Google displays.
#
# Do NOT wrap values in quotes. `source .env` hides the mistake by stripping
# them; GitHub Actions passes the value literally and Gmail then rejects it.
#
# Then verify before deploying:  python -m watcher.main --test-mail

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SSL=true

SMTP_USER=you@gmail.com
SMTP_PASSWORD=your16charapppass   # NEVER put the real one here — this file is committed
MAIL_FROM=you@gmail.com
MAIL_TO=you@gmail.com
